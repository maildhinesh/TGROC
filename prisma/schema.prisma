// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  OFFICE_BEARER
  MEMBER
}

enum UserStatus {
  ACTIVE
  INACTIVE
  PENDING
}

enum MembershipType {
  INDIVIDUAL
  FAMILY
  STUDENT_INDIVIDUAL
  STUDENT_FAMILY
}

enum FamilyRelation {
  SPOUSE
  CHILD
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
}

enum RsvpStatus {
  YES
  NO
  MAYBE
}

enum PerformanceType {
  SINGING
  DANCE
  SKIT
  POEM_RECITAL
  QUIZ
  STANDUP
}

enum MicType {
  STANDING
  HANDHELD
}

enum EventFeeType {
  FAMILY
  INDIVIDUAL
}

enum MembershipReminderType {
  DAYS_10
  DAYS_5
  DAYS_1
  EXPIRED
}

enum ExpenseCategory {
  HALL_RENT
  FOOD
  SUPPLIES
  CLEANING
  MISCELLANEOUS
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum CouponStatus {
  DRAFT
  PUBLISHED
  EXPIRED
}

enum MemberCouponStatus {
  ACTIVE
  REDEEMED
  EXPIRED
}

enum SchoolRole {
  SCHOOL_PARENT
  SCHOOL_TEACHER
  SCHOOL_ADMIN
}

enum SchoolEnrollmentStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  WITHDRAWN
}

enum SchoolYearStatus {
  PLANNED
  ACTIVE
  CLOSED
}

enum ClassSessionStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  emailVerified   DateTime?
  name            String?
  image           String?
  password        String?
  role              Role           @default(MEMBER)
  status            UserStatus     @default(PENDING)
  membershipType    MembershipType?
  membershipExpiry  DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  accounts             Account[]
  sessions             Session[]
  profile              Profile?
  familyMembers        FamilyMember[]
  contactInfo          ContactInfo?
  notificationSettings NotificationSettings?
  membershipFees       MembershipFee[]
  events               Event[]
  rsvps                EventRsvp[]
  eventPricings            EventPricing[]
  feeReminders             EventFeeReminder[]
  membershipReminders      MembershipExpiryReminder[]
  checkIns                 EventCheckIn[]
  expenses                 EventExpense[]
  coupons                  Coupon[]
  memberCoupons            MemberCoupon[]
  schoolRoleAssignments    SchoolUserRole[]
  ownedStudentProfiles     StudentProfile[]        @relation("StudentParent")
  parentEnrollments        SchoolEnrollment[]      @relation("EnrollmentParent")
  reviewedEnrollments      SchoolEnrollment[]      @relation("EnrollmentReviewedBy")
  teacherClassAssignments  ClassTeacherAssignment[] @relation("ClassTeacher")
  createdSchoolYears       SchoolYear[]            @relation("SchoolYearUpdatedBy")
  attendanceMarked         StudentAttendance[]     @relation("AttendanceMarkedBy")
  gradesMarked             StudentGrade[]          @relation("GradeMarkedBy")
  schoolEnrollmentSettingsUpdates SchoolEnrollmentSettings[] @relation("SchoolEnrollmentSettingsUpdatedBy")

  @@map("users")
}

model MembershipFee {
  id             String         @id @default(cuid())
  membershipType MembershipType
  amount         Decimal        @db.Decimal(10, 2)
  effectiveFrom  DateTime
  effectiveTo    DateTime?
  notes          String?
  createdById    String
  createdAt      DateTime       @default(now())

  createdBy User @relation(fields: [createdById], references: [id])

  @@map("membership_fees")
}

model Event {
  id          String      @id @default(cuid())
  name        String
  description String?     @db.Text
  eventDate   DateTime
  venue       String
  posterUrl   String?
  status      EventStatus @default(DRAFT)
  performanceRegOpen     Boolean   @default(false)
  performanceRegDeadline DateTime?
  createdById String
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  createdBy User        @relation(fields: [createdById], references: [id])
  rsvps     EventRsvp[]
  items     EventItem[]
  performances PerformanceRegistration[]
  pricing   EventPricing?
  feeReminders EventFeeReminder[]
  checkIns     EventCheckIn[]
  expenses     EventExpense[]

  @@map("events")
}

model EventRsvp {
  id                 String     @id @default(cuid())
  eventId            String
  userId             String?
  name               String
  email              String
  phone              String?
  attending          RsvpStatus @default(YES)
  adultCount         Int        @default(1)
  kidCount           Int        @default(0)
  vegetarianCount    Int        @default(0)
  nonVegetarianCount Int        @default(0)
  notes              String?
  createdAt          DateTime   @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  items EventRsvpItem[]

  @@unique([eventId, email])
  @@map("event_rsvps")
}

model EventItem {
  id             String   @id @default(cuid())
  eventId        String
  name           String
  description    String?
  quantityNeeded Int      @default(1)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())

  event     Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  rsvpItems EventRsvpItem[]

  @@map("event_items")
}

model EventRsvpItem {
  id       String @id @default(cuid())
  rsvpId   String
  itemId   String
  quantity Int    @default(1)

  rsvp EventRsvp @relation(fields: [rsvpId], references: [id], onDelete: Cascade)
  item EventItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([rsvpId, itemId])
  @@map("event_rsvp_items")
}

model PerformanceRegistration {
  id                String          @id @default(cuid())
  eventId           String
  performanceType   PerformanceType
  isGroup           Boolean         @default(false)
  programName       String
  duration          String
  coordinatorName   String
  coordinatorEmail  String
  coordinatorPhone  String
  participantCount  Int?
  songList          String?         @db.Text
  micCount          Int?
  micType           MicType?
  additionalDetails String?         @db.Text
  agreedToTerms     Boolean         @default(false)
  createdAt         DateTime        @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@map("performance_registrations")
}

model EventPricing {
  id                String        @id @default(cuid())
  eventId           String        @unique
  isFree            Boolean       @default(true)
  feeType           EventFeeType?
  // Family fee tiers
  memberFamilyFee     Decimal?    @db.Decimal(10, 2)
  nonMemberFamilyFee  Decimal?    @db.Decimal(10, 2)
  // Individual fee tiers
  memberAdultFee      Decimal?    @db.Decimal(10, 2)
  nonMemberAdultFee   Decimal?    @db.Decimal(10, 2)
  memberKidFee        Decimal?    @db.Decimal(10, 2)
  nonMemberKidFee     Decimal?    @db.Decimal(10, 2)
  // Student fee tiers
  studentMemberFee    Decimal?    @db.Decimal(10, 2)
  studentNonMemberFee Decimal?    @db.Decimal(10, 2)
  notes             String?       @db.Text
  updatedAt         DateTime      @updatedAt
  updatedById       String

  event     Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  updatedBy User  @relation(fields: [updatedById], references: [id])

  @@map("event_pricing")
}

model EventFeeReminder {
  id             String   @id @default(cuid())
  eventId        String
  sentAt         DateTime @default(now())
  sentById       String
  recipientCount Int
  message        String?  @db.Text

  event  Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  sentBy User  @relation(fields: [sentById], references: [id])

  @@map("event_fee_reminders")
}

model EventCheckIn {
  id          String   @id @default(cuid())
  eventId     String
  name        String
  email       String
  phone       String?
  adultCount  Int      @default(1)
  kidCount    Int      @default(0)
  amountPaid  Decimal? @db.Decimal(10, 2)
  paymentNote String?
  checkedInById String
  checkedInAt   DateTime @default(now())

  event       Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  checkedInBy User  @relation(fields: [checkedInById], references: [id])

  @@unique([eventId, email])
  @@map("event_checkins")
}

model EventExpense {
  id          String          @id @default(cuid())
  eventId     String
  category    ExpenseCategory
  description String
  amount      Decimal         @db.Decimal(10, 2)
  createdById String
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  event     Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  createdBy User  @relation(fields: [createdById], references: [id])

  @@map("event_expenses")
}

model MembershipExpiryReminder {
  id           String                @id @default(cuid())
  userId       String
  reminderType MembershipReminderType
  expiryDate   DateTime              @db.Date
  sentAt       DateTime              @default(now())
  emailSent    Boolean               @default(false)
  emailError   String?               @db.Text

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, reminderType, expiryDate])
  @@map("membership_expiry_reminders")
}

model Profile {
  id          String    @id @default(cuid())
  userId      String    @unique
  firstName   String
  lastName    String
  dateOfBirth DateTime?
  phone       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

model FamilyMember {
  id           String         @id @default(cuid())
  userId       String
  relationship FamilyRelation
  firstName    String
  lastName     String
  dateOfBirth  DateTime?
  email        String?
  phone        String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("family_members")
}

model ContactInfo {
  id        String   @id @default(cuid())
  userId    String   @unique
  address   String?
  city      String?
  state     String?
  zipCode   String?
  country   String?  @default("USA")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("contact_info")
}

model NotificationSettings {
  id                   String   @id @default(cuid())
  userId               String   @unique
  emailNotifications   Boolean  @default(true)
  smsNotifications     Boolean  @default(false)
  newsletterSubscribed Boolean  @default(true)
  eventReminders       Boolean  @default(true)
  membershipAlerts     Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_settings")
}

model SchoolEnrollmentSettings {
  id                   String   @id @default(cuid())
  isEnrollmentEnabled  Boolean  @default(false)
  updatedById          String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  updatedBy User? @relation("SchoolEnrollmentSettingsUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@map("school_enrollment_settings")
}

model SchoolUserRole {
  id        String     @id @default(cuid())
  userId    String
  role      SchoolRole
  isActive  Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
  @@map("school_user_roles")
}

model SchoolYear {
  id              String          @id @default(cuid())
  label           String          @unique
  startsOn        DateTime        @db.Date
  endsOn          DateTime        @db.Date
  enrollmentOpenOn  DateTime?     @db.Date
  enrollmentCloseOn DateTime?     @db.Date
  status          SchoolYearStatus @default(PLANNED)
  lastUpdatedById String?
  lastUpdatedAt   DateTime        @updatedAt
  createdAt       DateTime        @default(now())

  lastUpdatedBy User? @relation("SchoolYearUpdatedBy", fields: [lastUpdatedById], references: [id], onDelete: SetNull)
  calendarDays   SchoolCalendarDay[]
  enrollments    SchoolEnrollment[]
  classes        SchoolClass[]
  sessions       ClassSession[]
  classStudentAssignments ClassStudentAssignment[]

  @@map("school_years")
}

model SchoolCalendarDay {
  id           String   @id @default(cuid())
  schoolYearId String
  date         DateTime @db.Date
  isSchoolDay  Boolean  @default(false)
  note         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  schoolYear SchoolYear @relation(fields: [schoolYearId], references: [id], onDelete: Cascade)

  @@unique([schoolYearId, date])
  @@map("school_calendar_days")
}

model StudentProfile {
  id                    String   @id @default(cuid())
  parentUserId          String
  firstName             String
  lastName              String
  dateOfBirth           DateTime @db.Date
  gender                String?
  emergencyContactName  String?
  emergencyContactPhone String?
  notes                 String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  parent      User @relation("StudentParent", fields: [parentUserId], references: [id], onDelete: Cascade)
  enrollments SchoolEnrollment[]
  classAssignments ClassStudentAssignment[]
  attendanceEntries StudentAttendance[]
  grades            StudentGrade[]

  @@map("student_profiles")
}

model SchoolEnrollment {
  id              String                 @id @default(cuid())
  schoolYearId    String
  studentProfileId String
  parentUserId    String
  status          SchoolEnrollmentStatus @default(DRAFT)
  submittedAt     DateTime?
  reviewedAt      DateTime?
  reviewedByUserId String?
  rejectionReason String?
  approvedAt      DateTime?
  withdrawnAt     DateTime?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  schoolYear    SchoolYear     @relation(fields: [schoolYearId], references: [id], onDelete: Cascade)
  studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  parent        User           @relation("EnrollmentParent", fields: [parentUserId], references: [id], onDelete: Cascade)
  reviewedBy    User?          @relation("EnrollmentReviewedBy", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  medicalInfo   EnrollmentMedicalInfo?
  waivers       EnrollmentWaiver?

  @@unique([studentProfileId, schoolYearId])
  @@map("school_enrollments")
}

model EnrollmentMedicalInfo {
  id                    String   @id @default(cuid())
  enrollmentId          String   @unique
  insuranceProviderName String
  insurancePolicyNumber String
  insuranceGroupNumber  String?
  insurancePhone        String?
  policyHolderName      String?
  pediatricianName      String
  pediatricianPhone     String
  pediatricianAddress   String?
  medicalNotes          String?
  updatedAt             DateTime @updatedAt

  enrollment SchoolEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  @@map("enrollment_medical_info")
}

model EnrollmentWaiver {
  id                      String   @id @default(cuid())
  enrollmentId            String   @unique
  medicalWaiverAccepted   Boolean  @default(false)
  medicalWaiverAcceptedAt DateTime?
  medicalWaiverVersion    Int
  mediaWaiverAccepted     Boolean  @default(false)
  mediaWaiverAcceptedAt   DateTime?
  mediaWaiverVersion      Int
  acceptedByUserId        String
  updatedAt               DateTime @updatedAt

  enrollment SchoolEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  @@map("enrollment_waivers")
}

model SchoolClass {
  id          String   @id @default(cuid())
  schoolYearId String
  classCode   String
  className   String
  levelOrGrade String
  maxCapacity Int?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  schoolYear SchoolYear @relation(fields: [schoolYearId], references: [id], onDelete: Cascade)
  teacherAssignments ClassTeacherAssignment[]
  studentAssignments ClassStudentAssignment[]
  sessions           ClassSession[]
  gradeCategories    GradeCategory[]
  gradeItems         GradeItem[]

  @@unique([schoolYearId, classCode])
  @@map("school_classes")
}

model ClassTeacherAssignment {
  id           String   @id @default(cuid())
  schoolClassId String
  teacherUserId String
  assignedFrom DateTime @default(now())
  assignedTo   DateTime?
  createdAt    DateTime @default(now())

  schoolClass SchoolClass @relation(fields: [schoolClassId], references: [id], onDelete: Cascade)
  teacher    User        @relation("ClassTeacher", fields: [teacherUserId], references: [id], onDelete: Cascade)

  @@map("class_teacher_assignments")
}

model ClassStudentAssignment {
  id             String   @id @default(cuid())
  schoolClassId  String
  studentProfileId String
  schoolYearId   String
  assignedOn     DateTime @default(now())
  removedOn      DateTime?
  createdAt      DateTime @default(now())

  schoolClass   SchoolClass   @relation(fields: [schoolClassId], references: [id], onDelete: Cascade)
  studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  schoolYear    SchoolYear    @relation(fields: [schoolYearId], references: [id], onDelete: Cascade)

  @@map("class_student_assignments")
}

model CampusClassroom {
  id        String   @id @default(cuid())
  roomCode  String   @unique
  roomName  String
  capacity  Int?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions ClassSession[]

  @@map("campus_classrooms")
}

model ClassSession {
  id          String            @id @default(cuid())
  schoolYearId String
  schoolClassId String
  calendarDate DateTime         @db.Date
  startTime   DateTime
  endTime     DateTime
  classroomId String
  status      ClassSessionStatus @default(SCHEDULED)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  schoolYear SchoolYear     @relation(fields: [schoolYearId], references: [id], onDelete: Cascade)
  schoolClass SchoolClass   @relation(fields: [schoolClassId], references: [id], onDelete: Cascade)
  classroom  CampusClassroom @relation(fields: [classroomId], references: [id], onDelete: Restrict)
  attendanceEntries StudentAttendance[]

  @@index([schoolClassId, calendarDate])
  @@map("class_sessions")
}

model StudentAttendance {
  id             String           @id @default(cuid())
  classSessionId String
  studentProfileId String
  status         AttendanceStatus
  note           String?
  markedByUserId String
  markedAt       DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  classSession  ClassSession  @relation(fields: [classSessionId], references: [id], onDelete: Cascade)
  studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  markedBy      User          @relation("AttendanceMarkedBy", fields: [markedByUserId], references: [id], onDelete: Restrict)

  @@unique([classSessionId, studentProfileId])
  @@map("student_attendance")
}

model GradeCategory {
  id          String   @id @default(cuid())
  schoolClassId String
  name        String
  weight      Decimal? @db.Decimal(5, 2)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  schoolClass SchoolClass @relation(fields: [schoolClassId], references: [id], onDelete: Cascade)
  gradeItems  GradeItem[]

  @@map("grade_categories")
}

model GradeItem {
  id          String   @id @default(cuid())
  schoolClassId String
  categoryId  String?
  title       String
  maxScore    Decimal  @db.Decimal(7, 2)
  assignedOn  DateTime @db.Date
  dueOn       DateTime? @db.Date
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  schoolClass SchoolClass   @relation(fields: [schoolClassId], references: [id], onDelete: Cascade)
  category    GradeCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  studentGrades StudentGrade[]

  @@map("grade_items")
}

model StudentGrade {
  id            String   @id @default(cuid())
  gradeItemId   String
  studentProfileId String
  score         Decimal  @db.Decimal(7, 2)
  letterGrade   String?
  comment       String?
  gradedByUserId String
  gradedAt      DateTime @default(now())
  updatedAt     DateTime @updatedAt

  gradeItem     GradeItem     @relation(fields: [gradeItemId], references: [id], onDelete: Cascade)
  studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  gradedBy      User          @relation("GradeMarkedBy", fields: [gradedByUserId], references: [id], onDelete: Restrict)

  @@unique([gradeItemId, studentProfileId])
  @@map("student_grades")
}

// NextAuth.js Models
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Coupon {
  id              String       @id @default(cuid())
  title           String
  businessName    String
  businessAddress String?
  businessHours   String?      @db.Text
  contactNumbers  String?
  logoUrl         String?
  discountType    DiscountType
  discountValue   Decimal      @db.Decimal(10, 2)
  expiryDate      DateTime
  description     String?      @db.Text
  status          CouponStatus @default(DRAFT)
  createdById     String
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  createdBy     User           @relation(fields: [createdById], references: [id])
  memberCoupons MemberCoupon[]

  @@map("coupons")
}

model MemberCoupon {
  id         String             @id @default(cuid())
  couponId   String
  userId     String
  code       String             @unique
  status     MemberCouponStatus @default(ACTIVE)
  redeemedAt DateTime?
  createdAt  DateTime           @default(now())

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([couponId, userId])
  @@map("member_coupons")
}
